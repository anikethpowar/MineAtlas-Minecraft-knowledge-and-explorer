# MineAtlas Project Configuration Example
# Copy this file to .env or use component-specific .env files in backend/ and frontend/

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database Configuration (SQLite local file)
DATABASE_URL=sqlite:///./data/mineatlas.db

# Astroworld API Configuration (Public upstream API)
ASTROWORLD_API_BASE_URL=https://api.astroworldmc.com
ASTROWORLD_API_TIMEOUT_SECONDS=15
ASTROWORLD_AUDIT_DELAY_SECONDS=1.3

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
