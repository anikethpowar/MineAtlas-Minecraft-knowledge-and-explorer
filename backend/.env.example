# Backend Environment Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# Database Configuration (SQLite local file)
DATABASE_URL=sqlite:///./data/mineatlas.db

# Astroworld API Configuration (Public upstream API)
ASTROWORLD_API_BASE_URL=https://api.astroworldmc.com
ASTROWORLD_API_TIMEOUT_SECONDS=15
ASTROWORLD_AUDIT_DELAY_SECONDS=1.3

# In-process Rate Limiting (Strict 50 req/min upstream cap)
ASTROWORLD_RATE_LIMIT_MAX_REQUESTS=50
ASTROWORLD_RATE_LIMIT_REFILL_SECONDS=1.2
ASTROWORLD_MAX_RETRIES=3
ASTROWORLD_RETRY_BACKOFF_SECONDS=1
